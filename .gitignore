# =========================================================
# RNS Manager / RNS Messenger - .gitignore unico del monorepo
# Non versionare MAI dati runtime, cache, identità o segreti.
# =========================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/

# ---------- Ambienti virtuali ----------
venv/
env/
.venv/
.env/

# ---------- Build e distribuzione ----------
build/
dist/
*.run
*.pyz
*.pkg

# ---------- Dati runtime delle applicazioni ----------
cache/
downloads/
tmp/
uploads/
storage/
*.db
*.sqlite
*.sqlite3
*.rfe
*.rsg
*.sock
rns_monitor.sock

# ---------- Identità e segreti ----------
*.key
*.pem
*.crt
*.secret
*.local
*.name
.rns_manager/

# ---------- Artefatti locali ----------
/RNS
/gateway_peers.db
/github_update.sh
*.log
*.bak
*.backup

# ---------- IDE / OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
